# /opt/hiphant/.env — 이 파일을 .env 로 복사해 값을 채운다.
#   cp .env.example .env && chmod 600 .env

# --- 도메인 ---
# Caddy 가 이 도메인으로 TLS 인증서를 발급한다. A 레코드가 이 서버 고정 IP 를 가리키고 있어야 한다.
API_DOMAIN=api.hiphant.pachylover.com

# --- DB ---
DB_NAME=highlight
DB_USER=highlight
# openssl rand -base64 24 로 생성
DB_PASSWORD=

# --- API 이미지 ---
# GHCR 사용:   ghcr.io/pachylover/hiphant-api:latest
# 로컬 빌드본: hiphant-api:<git 짧은 해시>
API_IMAGE=ghcr.io/pachylover/hiphant-api:latest

# --- 관리자 ---
# 32바이트 이상 랜덤. openssl rand -base64 48
ADMIN_JWT_SECRET=
# 최초 1회 계정 생성용. 계정이 만들어진 뒤에는 비워도 된다(기존 계정은 덮어쓰지 않는다).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- 기타 ---
GEMINI_API_KEY=dummy
RATE_LIMIT_PER_MINUTE=100

# --- 백업 (backup.sh) ---
# 비워 두면 S3 업로드를 건너뛰고 로컬에만 보관한다.
BACKUP_S3_URI=
# healthchecks.io 핑 URL. 비워 두면 알림 없이 동작한다.
BACKUP_PING_URL=
